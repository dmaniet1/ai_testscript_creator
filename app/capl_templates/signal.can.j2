testcase TC_{{ req.id | replace('-', '_') }}_SignalRange()
{
  float sigValue;
  int   samples;
  int   violations;

  TestCaseTitle("{{ req.id }}", "{{ req.title }}");
  TestCaseDescription("{{ req.description }}");

  samples    = 0;
  violations = 0;

  TestStep("RANGE_CHECK", "Monitoring {{ req.parameters.signal_name }} for 2000ms — valid range: {{ req.parameters.min_value }} to {{ req.parameters.max_value }} {{ req.parameters.unit }}");

  /* Sample signal for 2 seconds */
  while (timeNow() / 100000.0 < 2000) {
    sigValue = {{ req.parameters.signal_name }};
    samples++;

    if (sigValue < {{ req.parameters.min_value }} || sigValue > {{ req.parameters.max_value }}) {
      violations++;
      TestStep("VIOLATION", "Sample %d: {{ req.parameters.signal_name }} = %.4f {{ req.parameters.unit }} — OUT OF RANGE", samples, sigValue);
    }
    wait(10);
  }

  TestStep("SUMMARY", "Checked %d samples — %d violations found", samples, violations);

  if (violations == 0) {
    TestStepPass("RANGE_PASS", "{{ req.parameters.signal_name }} stayed within [{{ req.parameters.min_value }}, {{ req.parameters.max_value }}] {{ req.parameters.unit }} across all %d samples", samples);
  } else {
    TestStepFail("RANGE_FAIL", "{{ req.parameters.signal_name }} had %d range violation(s) out of %d samples", violations, samples);
  }
}
