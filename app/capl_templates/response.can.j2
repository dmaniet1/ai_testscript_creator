/*
 * Generated by CAPL-GEN
 * Requirement : {{ req.id }} - {{ req.title }}
 * Description : {{ req.description }}
 * Type        : response
 * Priority    : {{ req.priority }}
 * Generated   : {{ timestamp }}
 */

testcase TC_{{ req.id | replace('-', '_') }}_ResponseTime()
{
  message {{ req.parameters.request_id }}  request;
  float tSent, tReceived, elapsed;

  TestCaseTitle("{{ req.id }}", "{{ req.title }}");
  TestCaseDescription("{{ req.description }}");

  /* Send diagnostic request */
  request.dlc = 8;
  request.byte(0) = 0x02;
  request.byte(1) = 0x10;
  request.byte(2) = 0x01;

  tSent = timeNow() / 100000.0;
  output(request);

  TestStep("REQ_SENT", "Request sent on {{ req.parameters.request_id }} at %.2f ms", tSent);

  /* Wait for response */
  if (TestWaitForMessage({{ req.parameters.response_id }}, {{ req.parameters.max_response_ms * 2 }})) {
    tReceived = timeNow() / 100000.0;
    elapsed   = tReceived - tSent;

    TestStep("RESP_TIME", "Response received on {{ req.parameters.response_id }} — elapsed: %.2f ms (max: {{ req.parameters.max_response_ms }}ms)", elapsed);

    if (elapsed <= {{ req.parameters.max_response_ms }}) {
      TestStepPass("RESP_PASS", "Response time %.2f ms within limit of {{ req.parameters.max_response_ms }}ms", elapsed);
    } else {
      TestStepFail("RESP_FAIL", "Response time %.2f ms exceeded limit of {{ req.parameters.max_response_ms }}ms", elapsed);
    }
  } else {
    TestStepFail("NO_RESP", "No response received on {{ req.parameters.response_id }} within {{ req.parameters.max_response_ms * 2 }}ms");
  }
}
