/*
 * Generated by CAPL-GEN
 * Requirement : {{ req.id }} - {{ req.title }}
 * Description : {{ req.description }}
 * Type        : timing
 * Priority    : {{ req.priority }}
 * Generated   : {{ timestamp }}
 */

testcase TC_{{ req.id | replace('-', '_') }}_TimingCheck()
{
  message {{ req.parameters.message_id }} msg;
  float tFirst, tSecond, delta;
  int   received;

  TestCaseTitle("{{ req.id }}", "{{ req.title }}");
  TestCaseDescription("{{ req.description }}");

  received = 0;
  tFirst   = 0;
  tSecond  = 0;

  /* Wait for first message */
  if (TestWaitForMessage({{ req.parameters.message_id }}, 1000)) {
    tFirst  = timeNow() / 100000.0; /* convert to ms */
    received++;
  } else {
    TestStepFail("MSG_PRESENT", "Message {{ req.parameters.message_id }} not seen on bus within 1000ms");
    return;
  }

  /* Wait for second message */
  if (TestWaitForMessage({{ req.parameters.message_id }}, 1000)) {
    tSecond = timeNow() / 100000.0;
    received++;
  } else {
    TestStepFail("MSG_TIMING", "Second message {{ req.parameters.message_id }} not received");
    return;
  }

  delta = tSecond - tFirst;

  TestStep("CYCLE_TIME", "Measured cycle time: %.2f ms (expected {{ req.parameters.cycle_time_ms }}ms ± {{ req.parameters.tolerance_ms }}ms)", delta);

  if (delta >= {{ req.parameters.cycle_time_ms - req.parameters.tolerance_ms }} &&
      delta <= {{ req.parameters.cycle_time_ms + req.parameters.tolerance_ms }}) {
    TestStepPass("CYCLE_PASS", "Cycle time %.2f ms within tolerance", delta);
  } else {
    TestStepFail("CYCLE_FAIL", "Cycle time %.2f ms out of tolerance [{{ req.parameters.cycle_time_ms - req.parameters.tolerance_ms }}, {{ req.parameters.cycle_time_ms + req.parameters.tolerance_ms }}]", delta);
  }
}
