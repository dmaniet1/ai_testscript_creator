/*
 * Generated by CAPL-GEN  [Ethernet / SOME-IP]
 * Requirement : {{ req.id }} - {{ req.title }}
 * Description : {{ req.description }}
 * Type        : signal (Ethernet)
 * Protocol    : Ethernet / SOME-IP
 * Priority    : {{ req.priority }}
 * Generated   : {{ timestamp }}
 *
 * SOME-IP Service : 0x{{ req.parameters.someip_service_id }}
 * Instance        : 0x{{ req.parameters.someip_instance_id }}
 * Event Group     : 0x{{ req.parameters.someip_event_group_id }}
 * Event ID        : 0x{{ req.parameters.someip_event_id }}
 */

testcase TC_{{ req.id | replace('-', '_') }}_SignalRange()
{
  long eventReceived;

  TestCaseTitle("{{ req.id }}", "{{ req.title }}");
  TestCaseDescription("{{ req.description }}");

  /* ── Locate and subscribe to SOME-IP service ──────────────────────── */
  TestStep("SERVICE_FIND",
    "Looking for SOME-IP service 0x{{ req.parameters.someip_service_id }} "
    "instance 0x{{ req.parameters.someip_instance_id }}");

  if (!SomeIpSd_FindService(0x{{ req.parameters.someip_service_id }},
                             0x{{ req.parameters.someip_instance_id }},
                             2000)) {
    TestStepFail("SERVICE_FIND",
      "SOME-IP service 0x{{ req.parameters.someip_service_id }} not available within 2000ms");
    return;
  }

  TestStep("SERVICE_FOUND", "Service found — subscribing to event group 0x{{ req.parameters.someip_event_group_id }}");

  SomeIpSd_SubscribeEventgroup(0x{{ req.parameters.someip_service_id }},
                                0x{{ req.parameters.someip_instance_id }},
                                0x{{ req.parameters.someip_event_group_id }},
                                2000);

  /* ── Stimulate input signal ────────────────────────────────────────── */
  TestStep("INPUT_STIMULATE",
    "Setting {{ req.parameters.input_signal }} = {{ req.parameters.input_value }}");
  @sysvar::WiperCtrl::{{ req.parameters.input_signal }} = "{{ req.parameters.input_value }}";

  /* ── Await SOME-IP event notification ──────────────────────────────── */
  eventReceived = TestWaitForSomeIpEvent(0x{{ req.parameters.someip_service_id }},
                                          0x{{ req.parameters.someip_instance_id }},
                                          0x{{ req.parameters.someip_event_id }},
                                          500 /* timeout ms */);

  if (!eventReceived) {
    TestStepFail("EVENT_TIMEOUT",
      "SOME-IP event 0x{{ req.parameters.someip_event_id }} not received within 500ms");
    return;
  }

  TestStep("EVENT_RECEIVED", "SOME-IP event 0x{{ req.parameters.someip_event_id }} received");

  /* ── Verify output signal values ───────────────────────────────────── */
  {% if 'output_signals' in req.parameters %}
  {% for sig, expected in req.parameters.output_signals.items() %}
  if (@sysvar::WiperCtrl::{{ sig }} == "{{ expected }}") {
    TestStepPass("SIG_{{ sig | upper }}_PASS",
      "{{ sig }} = '{{ expected }}' as expected");
  } else {
    TestStepFail("SIG_{{ sig | upper }}_FAIL",
      "{{ sig }} expected '{{ expected }}' but got a different value");
  }
  {% endfor %}
  {% endif %}
}
