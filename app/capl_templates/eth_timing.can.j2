/*
 * Generated by CAPL-GEN  [Ethernet / SOME-IP]
 * Requirement : {{ req.id }} - {{ req.title }}
 * Description : {{ req.description }}
 * Type        : timing (Ethernet)
 * Protocol    : Ethernet / SOME-IP
 * Priority    : {{ req.priority }}
 * Generated   : {{ timestamp }}
 *
 * SOME-IP Service : 0x{{ req.parameters.someip_service_id }}
 * Instance        : 0x{{ req.parameters.someip_instance_id }}
 * Event Group     : 0x{{ req.parameters.someip_event_group_id }}
 * Event ID        : 0x{{ req.parameters.someip_event_id }}
 */

{% set timeout_ms = (req.parameters.detection_time_ms + 500) if 'detection_time_ms' in req.parameters else (req.parameters.get('reaction_time_ms', 50) + 200) %}

testcase TC_{{ req.id | replace('-', '_') }}_TimingCheck()
{
  float tStimulus;
  float tEvent;
  float elapsed;
  long  eventReceived;

  TestCaseTitle("{{ req.id }}", "{{ req.title }}");
  TestCaseDescription("{{ req.description }}");

  /* ── Subscribe to SOME-IP service ──────────────────────────────────── */
  TestStep("SERVICE_FIND",
    "Subscribing to SOME-IP service 0x{{ req.parameters.someip_service_id }}");

  if (!SomeIpSd_FindService(0x{{ req.parameters.someip_service_id }},
                             0x{{ req.parameters.someip_instance_id }},
                             2000)) {
    TestStepFail("SERVICE_FIND",
      "Service 0x{{ req.parameters.someip_service_id }} not found within 2000ms");
    return;
  }

  SomeIpSd_SubscribeEventgroup(0x{{ req.parameters.someip_service_id }},
                                0x{{ req.parameters.someip_instance_id }},
                                0x{{ req.parameters.someip_event_group_id }},
                                2000);

  /* ── Apply stimulus ─────────────────────────────────────────────────── */
  {% if 'press_duration_condition' in req.parameters %}
  {% set threshold_ms = (req.parameters.t_button_press_rear_window_s * 1000) | int %}
  {% if '<' in req.parameters.press_duration_condition %}
  /* Short press: hold {{ (threshold_ms * 0.8) | int }}ms which is < threshold ({{ threshold_ms }}ms) */
  TestStep("PRESS_START",
    "Pressing {{ req.parameters.input_signal }} — short press < {{ threshold_ms }}ms");
  tStimulus = timeNow() / 100000.0;
  @sysvar::WiperCtrl::{{ req.parameters.input_signal }} = "{{ req.parameters.input_value }}";
  wait({{ (threshold_ms * 0.8) | int }});
  @sysvar::WiperCtrl::{{ req.parameters.input_signal }} = "NotPsd";
  TestStep("PRESS_END", "Button released after {{ (threshold_ms * 0.8) | int }}ms");
  {% else %}
  /* Long press: hold {{ (threshold_ms * 1.5) | int }}ms which is > threshold ({{ threshold_ms }}ms) */
  TestStep("PRESS_START",
    "Pressing {{ req.parameters.input_signal }} — long press > {{ threshold_ms }}ms");
  tStimulus = timeNow() / 100000.0;
  @sysvar::WiperCtrl::{{ req.parameters.input_signal }} = "{{ req.parameters.input_value }}";
  wait({{ (threshold_ms * 1.5) | int }});
  @sysvar::WiperCtrl::{{ req.parameters.input_signal }} = "NotPsd";
  TestStep("PRESS_END", "Button released after {{ (threshold_ms * 1.5) | int }}ms");
  {% endif %}

  {% elif 'fault_condition' in req.parameters %}
  /* Fault injection: trigger {{ req.parameters.fault_condition }} externally */
  TestStep("FAULT_INJECT",
    "Fault condition active: {{ req.parameters.fault_condition }} — "
    "detection deadline: {{ req.parameters.detection_time_ms }}ms");
  tStimulus = timeNow() / 100000.0;

  {% else %}
  tStimulus = timeNow() / 100000.0;
  {% endif %}

  /* ── Wait for output event within deadline ──────────────────────────── */
  eventReceived = TestWaitForSomeIpEvent(0x{{ req.parameters.someip_service_id }},
                                          0x{{ req.parameters.someip_instance_id }},
                                          0x{{ req.parameters.someip_event_id }},
                                          {{ timeout_ms }});

  tEvent  = timeNow() / 100000.0;
  elapsed = tEvent - tStimulus;

  if (!eventReceived) {
    TestStepFail("EVENT_TIMEOUT",
      "SOME-IP event 0x{{ req.parameters.someip_event_id }} not received within {{ timeout_ms }}ms");
    return;
  }

  /* ── Evaluate timing ───────────────────────────────────────────────── */
  {% if 'detection_time_ms' in req.parameters %}
  TestStep("TIMING_RESULT",
    "Elapsed: %.2f ms — fault detection deadline: {{ req.parameters.detection_time_ms }}ms",
    elapsed);
  if (elapsed <= {{ req.parameters.detection_time_ms }}) {
    TestStepPass("DETECT_PASS",
      "Fault detected in %.2f ms (within D={{ req.parameters.detection_time_ms }}ms)", elapsed);
  } else {
    TestStepFail("DETECT_FAIL",
      "Fault detection %.2f ms exceeded D={{ req.parameters.detection_time_ms }}ms", elapsed);
  }
  {% else %}
  {% set r_ms = req.parameters.get('reaction_time_ms', 50) %}
  TestStep("TIMING_RESULT",
    "Elapsed: %.2f ms — reaction time limit: {{ r_ms }}ms", elapsed);
  if (elapsed <= {{ r_ms }}) {
    TestStepPass("REACT_PASS",
      "Output updated in %.2f ms (within R={{ r_ms }}ms)", elapsed);
  } else {
    TestStepFail("REACT_FAIL",
      "Output update time %.2f ms exceeds R={{ r_ms }}ms", elapsed);
  }
  {% endif %}

  /* ── Verify output signal states ────────────────────────────────────── */
  {% if 'output_signals' in req.parameters %}
  {% for sig, expected in req.parameters.output_signals.items() %}
  if (@sysvar::WiperCtrl::{{ sig }} == "{{ expected }}") {
    TestStepPass("SIG_{{ sig | upper }}_PASS",
      "{{ sig }} = '{{ expected }}' as expected");
  } else {
    TestStepFail("SIG_{{ sig | upper }}_FAIL",
      "{{ sig }} expected '{{ expected }}'");
  }
  {% endfor %}
  {% endif %}
}
