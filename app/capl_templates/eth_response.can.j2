/*
 * Generated by CAPL-GEN  [Ethernet / SOME-IP]
 * Requirement : {{ req.id }} - {{ req.title }}
 * Description : {{ req.description }}
 * Type        : response (Ethernet)
 * Protocol    : Ethernet / SOME-IP
 * Priority    : {{ req.priority }}
 * Generated   : {{ timestamp }}
 *
 * SOME-IP Service : 0x{{ req.parameters.someip_service_id }}
 * Instance        : 0x{{ req.parameters.someip_instance_id }}
 * Event Group     : 0x{{ req.parameters.someip_event_group_id }}
 * Event ID        : 0x{{ req.parameters.someip_event_id }}
 */

testcase TC_{{ req.id | replace('-', '_') }}_ResponseTime()
{
  float tSent;
  float tReceived;
  float elapsed;
  long  eventReceived;

  TestCaseTitle("{{ req.id }}", "{{ req.title }}");
  TestCaseDescription("{{ req.description }}");

  /* ── Find and subscribe to SOME-IP service ──────────────────────────── */
  TestStep("SERVICE_FIND",
    "Locating SOME-IP service 0x{{ req.parameters.someip_service_id }} "
    "instance 0x{{ req.parameters.someip_instance_id }}");

  if (!SomeIpSd_FindService(0x{{ req.parameters.someip_service_id }},
                             0x{{ req.parameters.someip_instance_id }},
                             2000)) {
    TestStepFail("SERVICE_FIND",
      "SOME-IP service 0x{{ req.parameters.someip_service_id }} not found within 2000ms");
    return;
  }

  SomeIpSd_SubscribeEventgroup(0x{{ req.parameters.someip_service_id }},
                                0x{{ req.parameters.someip_instance_id }},
                                0x{{ req.parameters.someip_event_group_id }},
                                2000);

  /* ── Stimulate input signal change ──────────────────────────────────── */
  TestStep("INPUT_CHANGE",
    "Changing {{ req.parameters.input_signal }} to Psd — measuring reaction time");
  @sysvar::WiperCtrl::{{ req.parameters.input_signal }} = "Psd";
  tSent = timeNow() / 100000.0;

  /* ── Wait for output event ───────────────────────────────────────────── */
  eventReceived = TestWaitForSomeIpEvent(0x{{ req.parameters.someip_service_id }},
                                          0x{{ req.parameters.someip_instance_id }},
                                          0x{{ req.parameters.someip_event_id }},
                                          {{ req.parameters.max_reaction_time_ms * 4 }});

  if (!eventReceived) {
    TestStepFail("NO_EVENT",
      "No SOME-IP event received after input change within "
      "{{ req.parameters.max_reaction_time_ms * 4 }}ms");
    /* Reset before returning */
    @sysvar::WiperCtrl::{{ req.parameters.input_signal }} = "NotPsd";
    return;
  }

  tReceived = timeNow() / 100000.0;
  elapsed   = tReceived - tSent;

  TestStep("REACTION_TIME",
    "Output event received — elapsed: %.2f ms (R={{ req.parameters.max_reaction_time_ms }}ms)",
    elapsed);

  if (elapsed <= {{ req.parameters.max_reaction_time_ms }}) {
    TestStepPass("REACTION_PASS",
      "Reaction time %.2f ms within R={{ req.parameters.max_reaction_time_ms }}ms", elapsed);
  } else {
    TestStepFail("REACTION_FAIL",
      "Reaction time %.2f ms exceeds R={{ req.parameters.max_reaction_time_ms }}ms", elapsed);
  }

  /* ── Reset input ─────────────────────────────────────────────────────── */
  @sysvar::WiperCtrl::{{ req.parameters.input_signal }} = "NotPsd";
}
