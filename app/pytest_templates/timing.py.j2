import pytest


class Test_{{ req.id | replace('-', '_') }}_Timing:
    """{{ req.description }}"""

    REQ_ID       = "{{ req.id }}"
    MESSAGE_ID   = {{ req.parameters.message_id }}
    CYCLE_TIME   = {{ req.parameters.cycle_time_ms }}   # ms
    TOLERANCE    = {{ req.parameters.tolerance_ms }}    # ms

    def test_message_present(self, can_bus):
        """{{ req.id }} - Message {{ req.parameters.message_id }} is present on bus"""
        msg = can_bus.wait_for_message(self.MESSAGE_ID, timeout=1.0)
        assert msg is not None, (
            f"[{self.REQ_ID}] Message {self.MESSAGE_ID} not received within 1000ms"
        )

    def test_cycle_time(self, can_bus):
        """{{ req.id }} - Cycle time within {{ req.parameters.cycle_time_ms }}ms ± {{ req.parameters.tolerance_ms }}ms"""
        timestamps = []
        for _ in range(5):
            msg = can_bus.wait_for_message(self.MESSAGE_ID, timeout=1.0)
            assert msg is not None, f"[{self.REQ_ID}] Message {self.MESSAGE_ID} lost during cycle measurement"
            timestamps.append(msg.timestamp_ms)

        deltas = [timestamps[i+1] - timestamps[i] for i in range(len(timestamps)-1)]
        avg_cycle = sum(deltas) / len(deltas)

        lower = self.CYCLE_TIME - self.TOLERANCE
        upper = self.CYCLE_TIME + self.TOLERANCE

        assert lower <= avg_cycle <= upper, (
            f"[{self.REQ_ID}] Cycle time {avg_cycle:.2f}ms outside [{lower}, {upper}]ms"
        )
