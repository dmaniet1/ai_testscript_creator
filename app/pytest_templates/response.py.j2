import pytest
import time


class Test_{{ req.id | replace('-', '_') }}_Response:
    """{{ req.description }}"""

    REQ_ID          = "{{ req.id }}"
    REQUEST_ID      = {{ req.parameters.request_id }}
    RESPONSE_ID     = {{ req.parameters.response_id }}
    MAX_RESPONSE_MS = {{ req.parameters.max_response_ms }}

    def test_response_received(self, can_bus):
        """{{ req.id }} - ECU responds to {{ req.parameters.request_id }}"""
        can_bus.send_message(self.REQUEST_ID, [0x02, 0x10, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00])
        response = can_bus.wait_for_message(self.RESPONSE_ID, timeout=self.MAX_RESPONSE_MS / 1000.0)
        assert response is not None, (
            f"[{self.REQ_ID}] No response on {self.RESPONSE_ID} within {self.MAX_RESPONSE_MS}ms"
        )

    def test_response_time(self, can_bus):
        """{{ req.id }} - Response time <= {{ req.parameters.max_response_ms }}ms"""
        t_start = time.monotonic()
        can_bus.send_message(self.REQUEST_ID, [0x02, 0x10, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00])
        response = can_bus.wait_for_message(self.RESPONSE_ID, timeout=self.MAX_RESPONSE_MS / 1000.0)

        elapsed_ms = (time.monotonic() - t_start) * 1000

        assert response is not None, f"[{self.REQ_ID}] No response received"
        assert elapsed_ms <= self.MAX_RESPONSE_MS, (
            f"[{self.REQ_ID}] Response time {elapsed_ms:.1f}ms exceeded limit of {self.MAX_RESPONSE_MS}ms"
        )
