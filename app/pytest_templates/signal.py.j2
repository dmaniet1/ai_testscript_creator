import pytest


class Test_{{ req.id | replace('-', '_') }}_Signal:
    """{{ req.description }}"""

    REQ_ID      = "{{ req.id }}"
    SIGNAL_NAME = "{{ req.parameters.signal_name }}"
    MIN_VALUE   = {{ req.parameters.min_value }}
    MAX_VALUE   = {{ req.parameters.max_value }}
    UNIT        = "{{ req.parameters.unit }}"
    SAMPLE_MS   = 2000  # sampling duration in ms
    INTERVAL_MS = 10    # sampling interval in ms

    def test_signal_within_range(self, can_bus):
        """{{ req.id }} - {{ req.parameters.signal_name }} stays within [{{ req.parameters.min_value }}, {{ req.parameters.max_value }}] {{ req.parameters.unit }}"""
        violations = []
        elapsed = 0

        while elapsed < self.SAMPLE_MS:
            value = can_bus.get_signal(self.SIGNAL_NAME)
            assert value is not None, f"[{self.REQ_ID}] Signal {self.SIGNAL_NAME} not available"

            if not (self.MIN_VALUE <= value <= self.MAX_VALUE):
                violations.append(value)

            can_bus.sleep(self.INTERVAL_MS)
            elapsed += self.INTERVAL_MS

        assert len(violations) == 0, (
            f"[{self.REQ_ID}] {self.SIGNAL_NAME} had {len(violations)} violation(s): "
            f"{violations[:5]}{'...' if len(violations) > 5 else ''} "
            f"(valid range: {self.MIN_VALUE}–{self.MAX_VALUE} {self.UNIT})"
        )
